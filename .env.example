# Копирайте като .env и попълнете при нужда.
# Ключ за TomTom (ПТП, задръствания, затворени пътища): https://developer.tomtom.com — безплатен.
TOMTOM_API_KEY=
# Собствен OSRM сървър (по подразбиране публичният демо сървър)
# OSRM_URL=https://router.project-osrm.org
# OFFLINE=1 → без външни заявки (права линия, без прогноза и условия) — резервен вариант
OFFLINE=0
